# Local development defaults only. Never put production secrets in this file.
POSTGRES_DB=infoscope
POSTGRES_USER=infoscope
POSTGRES_PASSWORD=infoscope-local
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://infoscope:infoscope-local@127.0.0.1:5432/infoscope
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=false
WORKER_POLL_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
WORKER_STALE_AFTER_SECONDS=20
MAINTENANCE_STALE_AFTER_SECONDS=60
EVENT_LOCALIZATION_BATCH_SIZE=10
EVENT_LOCALIZATION_BATCH_CONCURRENCY=2
EVENT_LOCALIZATION_MAX_ATTEMPTS=3
TRENDRADAR_CONFIG_PATH=backend/config/trendradar.yaml

# Telegram user API. Keep the API hash and generated session file local.
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=replace-with-your-secret
# TELEGRAM_PHONE=+8613800000000
TELEGRAM_SESSION_PATH=.state/telegram/infoscope
TELEGRAM_FOLDER_TITLE=News
TELEGRAM_INITIAL_MESSAGE_LIMIT=100
NORMALIZATION_BATCH_SIZE=500
DEDUPLICATION_BATCH_SIZE=500

# Window Analysis model. Put real keys only in the local .env file.
ANALYSIS_API_BASE_URL=https://api.deepseek.com
ANALYSIS_MODEL=deepseek-v4-flash
# ANALYSIS_API_KEYS=sk-first,sk-second,sk-third
ANALYSIS_TIMEOUT_SECONDS=180
ANALYSIS_MAX_RETRIES=3
ANALYSIS_MAX_TOKENS=16384
USER_ANALYSIS_MAX_TOKENS=16384
# Optional user-selectable providers. Keys stay on the server and are never returned by API.
DRAGON_API_BASE_URL=
DRAGON_API_KEYS=
DRAGON_MODEL=gpt-5.5
AIPING_API_BASE_URL=
AIPING_API_KEYS_GROUP_1=
AIPING_API_KEYS_GROUP_2=
WINDOW_ANALYSIS_MAX_WINDOWS=24
WINDOW_ANALYSIS_MAX_SIGNALS=50
WINDOW_ANALYSIS_MAX_INPUT_CHARS=100000
WINDOW_ANALYSIS_MAX_BATCHES=64
WINDOW_ANALYSIS_BATCH_CONCURRENCY=3
EVENT_RECONSTRUCTION_CANDIDATE_LIMIT=100

# Phase 4 public Research runtime. Keep runtime credentials outside the repository.
RESEARCH_OPENCLAW_EXECUTABLE=openclaw
RESEARCH_AGENT_REACH_EXECUTABLE=agent-reach
RESEARCH_OPENCLAW_CONFIG_PATH=.state/openclaw/research.json
RESEARCH_OPENCLAW_STATE_DIR=.state/openclaw/research
RESEARCH_OPENCLAW_MODEL=deepseek/deepseek-chat
RESEARCH_DEEPSEEK_API_KEY=
# The Research subprocess credential allowlist is fixed in code to DEEPSEEK_API_KEY.
# Export DEEPSEEK_API_KEY in the worker process environment; do not commit it here.
RESEARCH_TIMEOUT_SECONDS=300
RESEARCH_MAX_ATTEMPTS=3

# Phase 4 internal Ask Database Comparison. Uses the Analysis model settings above.
ASK_COMPARISON_MAX_ATTEMPTS=3
ASK_RESEARCH_BRIDGE_MAX_ATTEMPTS=3
ASK_EVENT_RECONCILIATION_MAX_ATTEMPTS=3
ASK_FINALIZATION_MAX_ATTEMPTS=3
BACKWRITE_MAX_ATTEMPTS=3
PERSONALIZATION_MAX_ATTEMPTS=3
PERSONALIZATION_BATCH_SIZE=10
PERSONALIZATION_BATCH_CONCURRENCY=2
BRIEF_MAX_ATTEMPTS=3
